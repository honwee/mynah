# Mynah PRODUCTION compose env — copy to .env.prod and fill in.
#   cp .env.prod.example .env.prod && edit
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Values below are an EXAMPLE topology — replace every host path. Anything marked
# SECRET must never be committed.

# ---- GPU assignment (CDI device index on the host) ----
# Example: GPU0 = TTS (+ host ollama), GPU1 = MuseTalk pool + ASR. Single-GPU hosts: set all to 0.
TTS_GPU=0
MUSETALK_GPU=1
ASR_GPU=1

# ---- Ports ----
CORED_HTTP_PORT=8020
CORED_TLS_PORT=8443
ADMIN_HTTP_PORT=9080
ADMIN_TLS_PORT=9443
MUSETALK_PORT=9414
MUSETALK2_PORT=9417
ASR_PORT=9402
ASR_HTTP_PORT=9404
TTS_PORT=8091

# ---- Worker pool ----
# Port RANGE cored watches. It joins whichever workers answer, so the console
# can scale the pool without restarting cored. Pool size = the concurrency
# quota total the console enforces.
# Must cover the compose-managed workers (9414/9417) plus room for dynamic slots.
WORKER_POOL=127.0.0.1:9414-9421

# ---- TLS (paths relative to /app, i.e. the bind-mounted tls/ dir) ----
CORED_TLS_CERT=tls/server.fullchain.crt
CORED_TLS_KEY=tls/server.key

# ---- MuseTalk assets (host paths; mounted read-only at the SAME path) ----
MUSETALK_REPO=/srv/third_party/MuseTalk
MUSETALK_MODELS_DIR=/srv/third_party/MuseTalk/models
MUSETALK_AVATAR_DIR=/srv/third_party/MuseTalk/results/v15/avatars/leiya_mt

# 所有引擎素材的公共根目录，只读挂进 cored。cored 不读内容，但**创建 worker
# 之前要 stat 一遍**素材路径——缺哪个路径就在控制台上说清楚，而不是让 worker
# 起来就崩。这个校验跑在 cored 容器里，所以下面每个 MUSETALK_* / FLASHHEAD_*
# 路径（以及 models 符号链接的目标）都必须落在这个根之下，否则引擎一律显示
# 「素材未就绪」，池根本组不起来。
MATERIAL_ROOT=/srv

# ---- Idle / action assets cored streams when she isn't speaking ----
# Keyed BY AVATAR ID: "<avatar>=<path>", comma-separated (split on the first
# "=", so ids containing colons like bake:leiya_mt are fine). A bare path with
# no "=" lands on "default", the avatar an unbound session runs under.
#
# An avatar with NO entry here is not broken — its idle segment is rendered live
# by the engine, showing the right person at the cost of a permanently busy
# worker. So every avatar a channel is bound to wants a key, or the console's
# 「待机实时生成」badge will tell you why the GPU never idles.
IDLE_ASSET_DIR=/srv/mynah-data/idle
IDLE_IVF=default=/srv/mynah-data/idle/idle_leiya_idle.h264f,bake:leiya_mt=/srv/mynah-data/idle/idle_leiya_idle.h264f
# Action clips use "@" rather than a second colon ("bake:x:wave" is ambiguous):
# "<action>@<avatar>=<path>". An action on an avatar with no idle entry is fatal
# at boot — the clip lives in that avatar's baked frame domain and can't play
# without it.
ACTIONS=wave@default=/srv/mynah-data/idle/idle_leiya_wave.h264f,wave@bake:leiya_mt=/srv/mynah-data/idle/idle_leiya_wave.h264f

# ---- 待机烘焙（:9405 avatartrain worker + cored 侧的接头） ----
# 「给这个形象烘一段待机」那条链。烘完之后该形象的待机变成 cored 直接回放的
# 预编码流（0 显存）；没烘过的形象走引擎实时生成（人对，但 worker 一直忙）。
#
# 所有路径必须只有这一处出处（compose + 本文件），不要再在脚本里写死。
IDLEBAKE_PORT=9405
IDLEBAKE_GPU=1
# 阶段依赖（都必须落在 MATERIAL_ROOT 之下，否则容器里看不见）
LIVEPORTRAIT_DIR=/srv/third_party/LivePortrait
# render_neutral.py 来自 LiveTalking，不在本仓库里；没有它就只能烘不带
# FlashHead 中性帧的待机（待机与说话的框选会对不齐）。
RENDER_NEUTRAL=/srv/third_party/LiveTalking/tools/render_neutral.py
# `builtin:d9` / `builtin:d14` 这类内置骨架的解析目录。LivePortrait 自带 22 个
# 驱动 .pkl，直接用它自己的目录，不必再复制一份。
MOTION_BUILTIN_DIR=/srv/third_party/LivePortrait/assets/examples/driving
# 产出目录（worker 写、cored 只读 CACHE 那个）。放在 MATERIAL_ROOT 之下，
# cored 才能 stat 到缓存命中。
IDLEBAKE_CACHE_DIR=/srv/mynah/idlebake/cache
IDLEBAKE_ASSET_DIR=/srv/mynah/idlebake/assets
IDLEBAKE_MOTION_DIR=/srv/mynah/idlebake/motions
IDLEBAKE_TRAIN_DIR=/srv/mynah/idlebake/training

# ---- ASR model cache (mounted to /root/.cache/modelscope in-container) ----
MODELSCOPE_CACHE=/root/.cache/modelscope

# ---- TTS ----
# Default service is tts-edge (free Microsoft Edge voices, CPU, needs internet).
# Best practice for production: Qwen3-TTS (profile qwen-tts, fill the three
# vars below) or a cloud OpenAI-compatible speech endpoint in TTS_URL.
VLLM_OMNI_DIR=/srv/third_party/vllm-omni
TTS_MODEL_DIR=/srv/models/qwen3-tts/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_MODEL_NAME=qwen3-tts-customvoice
TTS_GPU_UTIL=0.45
TTS_URL=http://127.0.0.1:8091
VOICE=zh-CN-XiaoxiaoNeural   # Qwen3-TTS example: vivian

# ---- Local LLM (host-native ollama) ----
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---- Qwen realtime cloud brain ----
QWEN_RT_URL=wss://<workspace>.<region>.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_RT_MODEL=qwen-audio-3.0-realtime-flash
QWEN_RT_VOICE=longanqian
QWEN_RT_KEY=                     # SECRET — DashScope api key

# ---- Database ----
# docker-compose.full.yml 用下面的 POSTGRES_* 自行拼 DSN，不读这一项。
# 保留是给宿主侧脚本用（cored.env / psql 直连），保持两边一致。
PL_DB_DSN=                       # SECRET — postgres://user:pass@127.0.0.1:5432/mynah

# ---- PostgreSQL（唯一有状态服务） ----
# ⚠️ 必须是带 pgvector 的镜像。0001_init.sql 里有 CREATE EXTENSION vector，
#    官方 postgres:16.3 不含该扩展。compose 用 pgvector/pgvector:pg16。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                 # SECRET
POSTGRES_DB=personalive
POSTGRES_PORT=5432
POSTGRES_DATA=/srv/mynah-data/postgres

# ---- STUN（WebRTC） ----
STUN_URLS=stun:stun.l.google.com:19302

# ---- Redis（可选，profile=redis 才启动） ----
# 当前无代码消费；预留给「cored 多实例」场景（共享频道注册表/配额）。
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ---- ASR 瘦身（可选） ----
# 云端大脑 + 云端判停时，SenseVoice 模型全程不跑，但进程仍是全栈唯一的
# Opus 解码器。设为 --decode-only 可跳过模型加载、省约 1.4GB 显存。
# ⚠️ 切回本地判轮次前必须清空此项并重启 asr，否则会话会被拒绝。
# ⚠️ 开启后声音复刻的「参考文本自动识别」不可用（需手动输入）。
ASR_EXTRA_ARGS=

# ---- 引擎切换素材（仅换引擎时需要；扩缩容是克隆现有 worker） ----
# FlashHead：只需仓库目录 + 一张肖像图，不需要烘焙素材。
# ⚠️ FLASHHEAD_DIR 现在还被待机烘焙 worker 用（Stage A 渲中性帧），
#    即使你不打算跑 FlashHead 引擎也要填对。
FLASHHEAD_DIR=/srv/third_party/SoulX-FlashHead
FLASHHEAD_AVATAR=/srv/third_party/SoulX-FlashHead/examples/linxia.jpg
# 新建 worker 的公共挂载
POOL_WORKERS_DIR=/srv/mynah/workers
POOL_GEN_DIR=/srv/mynah/gen
POOL_CACHE_VOLUME=personalive_avatar-cache

# ---- 烘焙形象目录（控制台可绑定的形象来源） ----
# cored 对它是**读写**的：烘焙的最后一步是把产物 rename 进来。
AVATAR_BAKES_DIR=/srv/third_party/MuseTalk/results/v15/avatars

# ---- 形象烘焙（控制台上传视频 → 素材目录） ----
# 镜像 = 服务镜像 + ffmpeg + face_alignment，需先单独构建：
#   docker build -t mynah/musetalk-bake:prod \
#     -f deploy/compose/worker-musetalk-bake.Dockerfile .
AVATAR_BAKE_IMAGE=mynah/musetalk-bake:prod
# 上传与抽帧的暂存目录。cored 写它，并把同一个宿主路径挂进烘焙容器，
# 所以容器内外必须是同一个字符串。20 秒素材的帧约 1GB，作业结束即清理。
AVATAR_BAKE_WORK_DIR=/srv/mynah/bakework
# face_alignment 的 FAN 权重（约 180MB）。指向宿主缓存可让烘焙完全离线；
# 留空则第一次烘焙会联网下载。
AVATAR_BAKE_TORCH_CACHE=/root/.cache/torch

# 内置肖像目录，**宿主路径**（不是 /app/workers/avatar/assets）。
# 同一个字符串有三个视角不同的消费者：avatar worker（容器，当 cond_image 用）、
# cored（容器，待机烘焙入队前 stat 这张源图）、:9405 待机烘焙 worker
# （宿主裸进程，根本没有 /app）。用容器路径会报
# `source image for avatar "f" not found on server`。
# workers 树在各容器里除了 /app/workers 之外还会按宿主原路径再挂一次（只读）。
AVATAR_ASSETS_DIR=/srv/mynah/workers/avatar/assets
