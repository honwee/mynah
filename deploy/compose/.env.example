# Mynah dev compose — copy to .env and adjust.
#
# ⚠️ FILESYSTEM PATHS BELOW ARE EXAMPLES, NOT WORKING DEFAULTS. They used to be
# baked into docker-compose.yml as `${VAR:-/data/personalive/...}` — the data disk
# of one particular machine. When that machine was rebuilt the "defaults" pointed
# at nothing, docker happily created empty dirs at those paths, and jobs failed
# minutes later inside a subprocess. Those defaults are gone: compose now aborts
# `up` naming the variable you forgot. Point the paths below at your own disk.

# ---- GPU (CDI device index on the host; container sees it as cuda:0) ----
AVATAR_GPU=2

# ---- Ports (chosen to NOT collide with prod 8020/8443 or test 8031/8032,
#      and workers 9401/9412/9413/9414/9406) ----
CORED_HTTP_PORT=8050
CORED_TLS_PORT=8455
TURN_PORT=9416

# ---- Addresses cored dials ----
# Default avatar engine is FlashHead on :9421. (For the wav2lipLS profile instead,
# set AVATAR_ADDR=127.0.0.1:9420.)
AVATAR_ADDR=127.0.0.1:9421
TURN_ADDR=127.0.0.1:9416
ASR_ADDR=127.0.0.1:9402          # host-native ASR (not containerized)

# ---- Host-native model services cored talks to ----
TTS_URL=http://127.0.0.1:8091
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_KEY=                         # bearer key for a cloud/remote OpenAI-compatible LLM (blank for ollama/local)
# EdgeTTS (default tier) voice ids look like zh-CN-XiaoxiaoNeural / en-US-AriaNeural;
# Qwen3-TTS voices look like vivian / serena. Pick one that matches TTS_URL.
VOICE=zh-CN-XiaoxiaoNeural

# ===========================================================================
# DEFAULT avatar engine — FlashHead (started by a plain `docker compose up`).
# Apache-2.0 SoulX-FlashHead diffusion talking-head. It speaks the bundled default
# portrait (workers/avatar/assets/mynah-default.jpg) — no baked asset needed.
# Provision the engine repo + weights once:  bash deploy/compose/setup-flashhead.sh
# ===========================================================================
FLASHHEAD_PORT=9421
FLASHHEAD_GPU=2
FLASHHEAD_DIR=/srv/mynah/SoulX-FlashHead   # cloned + weights by setup-flashhead.sh
FLASHHEAD_AVATAR=                                  # blank = bundled default portrait
FLASHHEAD_IDLE_DIR=                                # blank = generated-silence idle (optional; bake to improve)
# torch.compile gates (setup-flashhead.sh applies flashhead-compile-env.patch).
# Default 0/0 = compile OFF: ~14s cold start at 1.56x realtime (vs ~139s at 2.28x
# with compile on). Set both to 1 for max throughput headroom. See README.
FLASHHEAD_COMPILE_MODEL=0
FLASHHEAD_COMPILE_VAE=0

# ---- Turn detector — Smart Turn v3.2 (Pipecat, BSD-2), audio end-of-turn ----
# The model is BUNDLED in the repo (workers/turn/models/smart-turn-v3.2.onnx) —
# nothing to download. Turn-taking is on by default (cored --turn-detector).
# TURN_INTRA_OP_THREADS = onnx CPU threads: ~28ms at 4, ~15ms at 8 (default 4).
TURN_INTRA_OP_THREADS=4

# ===========================================================================
# Light alternative avatar engine — wav2lipLS (opt-in: `--profile wav2lipls`).
# Lower VRAM / higher frame-rate; prefer on modest GPUs. Bring it up instead of
# FlashHead with:
#   AVATAR_ADDR=127.0.0.1:9420 docker compose --profile wav2lipls up -d cored avatar turn
# ===========================================================================
AVATAR_PORT=9420
# PL_MODELS_DIR is where avatar.sh downloads land (checkpoint + baked avatar +
# HuBERT). Bind-mounted into the worker at the SAME path.
PL_MODELS_DIR=/srv/mynah/models
# Baked avatar dir (full_imgs/face_imgs/coords.pkl). Blank = $PL_MODELS_DIR/avatars/
# personalive-default; avatar.sh fetches it from DEFAULT_AVATAR_URL when absent.
AVATAR_DIR=
DEFAULT_AVATAR_URL=
# wav2lipLS checkpoint — blank = $PL_MODELS_DIR/wav2lipls/wav2lipls-<FACE_SIZE>.pth;
# avatar.sh fetches it from WAV2LIPLS_CKPT_URL when absent.
WAV2LIPLS_CKPT=
WAV2LIPLS_CKPT_URL=
FACE_SIZE=384

# ---- Avatar-training worker (profile: avatartrain) ----
# Image-training pipeline orchestrator (:9425): /train (stub), /extract
# (LivePortrait motion .pkl), /bake (FlashHead+LivePortrait -> idle_<name>.h264f).
# 9425 avoids the host-native systemd training stub on :9405.
AVATARTRAIN_PORT=9425
AVATARTRAIN_GPU=3
# Stage runtimes (repos), bind-mounted read-only. Provide your own checkouts.
LIVEPORTRAIT_DIR=/srv/mynah/LivePortrait
# render_neutral.py is an EXTERNAL tool (from LiveTalking) — not shipped here.
# Point this at your own copy to enable idle baking; half-body mode also needs
# face-parse-bisent weights at FACEPARSE_DIR.
RENDER_NEUTRAL=/srv/mynah/tools/render_neutral.py
# Blank is allowed: half-body compositing is simply unavailable without it.
FACEPARSE_DIR=/srv/mynah/models/face-parse-bisent
# Output dirs (bind-mounted read-write).
TRAIN_ARTIFACT_DIR=/srv/mynah/training_artifacts
MOTION_PKL_DIR=/srv/mynah/motion_artifacts
BAKE_DIR=/srv/mynah/idle_assets
BAKE_CACHE_DIR=/srv/mynah/idle_cache
